# ── Required ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, dev only):
DATABASE_URL=sqlite+aiosqlite:///./tac.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/tac

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Free tracking: Terminal49 ──────────────────────────────────────────────────
# Sign up free at https://terminal49.com → Settings → API Key
# Covers 60+ carriers (Maersk, ZIM, MSC, Hapag, ONE, Evergreen, COSCO, ...)
TERMINAL49_API_KEY=
TERMINAL49_WEBHOOK_SECRET=

# ── Token expiry ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Email scanner (auto ETA updates from carrier emails) ──────────────────────
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as EMAIL_PASSWORD.
# Outlook: use imap-mail.outlook.com
EMAIL_IMAP_SERVER=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SCAN_INTERVAL_MINUTES=30
